# Path to the SQLite database (resolved relative to dashboard/ cwd)
DB_PATH=../leads.db

# Python binary used by the agent to spawn discovery/qualify/enrich
PYTHON_BIN=python3

# Paths to Python scripts (resolved relative to dashboard/ cwd)
DISCOVERY_SCRIPT=../discovery.py
QUALIFY_SCRIPT=../qualify.py
ENRICH_SCRIPT=../enrich.py

# Vercel API for `npm run sync-domains` — adds each lead's slug as a subdomain
# Token: https://vercel.com/account/settings/tokens (scope: this project)
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=stronadlatwojejfirmy
BASE_DOMAIN=stronadlatwojejfirmy.com.pl
# VERCEL_TEAM_ID=  # only if project is under a team
