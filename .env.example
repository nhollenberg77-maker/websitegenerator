# Google Places API key — required by discovery.py and enrich.py
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional override (default: leads.db in project root)
DB_PATH=leads.db

# Absolute URL waar het dashboard draait. Wordt gebruikt door email-template.ts
# om relatieve /api/photo en /unsubscribe links absoluut te maken voor mails.
# Default als niet gezet: https://app.stronadlatwojejfirmy.com.pl
DASHBOARD_URL=https://app.stronadlatwojejfirmy.com.pl
